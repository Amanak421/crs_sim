<?xml version="1.0"?>
<robot name="CRS_97">

    <!-- BASE LINK -->
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0.0825" rpy="0 0 0"/>
            <mass value="3.5"/>
            <inertia ixx="0.016" iyy="0.016" izz="0.016" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <mesh filename="meshes/00_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.0825" rpy="0 0 0"/>
            <geometry>
                <box size="0.2 0.2 0.165"/>
            </geometry>
        </collision>
    </link>

    <!--  JOINT 0  -->
    <joint name="joint0" type="revolute">
        <origin xyz="0 0 0.16" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="link_0"/>
        <axis xyz="0 0 1"/>
        <limit effort="30" velocity="1.0" lower="-3.0543" upper="3.0543"/>
    </joint>

    <!--  LINK 0  -->
    <link name="link_0">
        <inertial>
            <origin xyz="0 0 0.1125" rpy="0 0 0"/>
            <mass value="2.8"/>
            <inertia ixx="0.031" iyy="0.012" izz="0.028" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <mesh filename="meshes/00_link_0.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material  name="gray">
                <color rgba="0.78 0.75 0.75 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.1125" rpy="0 0 0"/>
            <geometry>
                <box size="0.160 0.514 0.23"/>
            </geometry>
        </collision>
    </link>

    <!--  JOINT 1  -->
    <joint name="joint1" type="revolute">
        <origin xyz="0 0 0.145" rpy="0 0 0"/>
        <parent link="link_0"/>
        <child link="link_1"/>
        <axis xyz="0 -1 0"/>
        <limit effort="30" velocity="1.0" lower="-1.57" upper="1.57"/>
    </joint>

    <!--  LINK 1  -->
    <link name="link_1">
        <inertial>
            <origin xyz="0 0 0.1525" rpy="0 0 0"/>
            <mass value="2.4"/>
            <inertia ixx="0.028" iyy="0.028" izz="0.010" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 -0.065 0" rpy="0 -1.57 0"/>
            <geometry>
                <mesh filename="meshes/01_link_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray">
                <color rgba="0.78 0.75 0.75 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.1525" rpy="0 0 0"/>
            <geometry>
                <box size="0.14 0.12 0.455"/>
            </geometry>
        </collision>
    </link>

    <!--  JOINT 2  -->
    <joint name="joint2" type="revolute">
        <origin xyz="0 0 0.305" rpy="0 0 0"/>
        <parent link="link_1"/>
        <child link="link_2"/>
        <axis xyz="0 -1 0"/>
        <limit effort="30" velocity="1.0" lower="-1.9199" upper="1.9199"/>
    </joint>

    <!--  LINK 2  -->
    <link name="link_2">
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.7"/>
            <inertia ixx="0.0014" iyy="0.0011" izz="0.0010" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 -0.05 0" rpy="0 -1.57 0"/>
            <geometry>
                <mesh filename="meshes/02_link_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>            
            <material name="gray">
                <color rgba="0.78 0.75 0.75 0.4"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry>
                <box size="0.11 0.102 0.17"/>
            </geometry>
        </collision>
    </link>

    <!--  JOINT 3  -->
    <joint name="joint3" type="revolute">
        <origin xyz="0 0 0.102" rpy="0 0 0"/>
        <parent link="link_2"/>
        <child link="link_3"/>
        <axis xyz="0 0 1"/>
        <limit effort="30" velocity="1.0" lower="-3.14" upper="3.14"/>
    </joint>

    <!--  LINK 3  -->
    <link name="link_3">
        <inertial>
            <origin xyz="0 0 0.1015" rpy="0 0 0"/>
            <mass value="1.3"/>
            <inertia ixx="0.0043" iyy="0.0043" izz="0.0024" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <mesh filename="meshes/03_link_3.stl" scale="0.001 0.001 0.001"/>
            </geometry>            
            <material  name="gray">
                <color rgba="0.78 0.75 0.75 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.1015" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.067" length="0.28"/>
            </geometry>
        </collision>
    </link>

    <!--  JOINT 4  -->
    <joint name="joint4" type="revolute">
        <origin xyz="0 0 0.228" rpy="0 -1.57 0"/>
        <parent link="link_3"/>
        <child link="link_4"/>
        <axis xyz="0 -1 0"/>
        <limit effort="30" velocity="1.0" lower="-1.8326" upper="1.8326"/>
    </joint>

    <!--  LINK 4  -->
    <link name="link_4">
        <inertial>
            <origin xyz="0.038 0 0" rpy="0 0 0"/>
            <mass value="0.3"/>
            <inertia ixx="0.00015" iyy="0.00017" izz="0.00019" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 -0.0275 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/04_link_4.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray">
                <color rgba="0.78 0.75 0.75 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.02 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder radius="0.042" length="0.056"/>
            </geometry>
        </collision>
    </link>

    <!--  JOINT 5  -->
    <joint name="joint5" type="revolute">
        <origin xyz="0.076 0 0" rpy="0 0 0"/>
        <parent link="link_4"/>
        <child link="link_5"/>
        <axis xyz="1 0 0"/>
        <limit effort="30" velocity="1.0" lower="-3.14" upper="3.14"/>
    </joint>

    <!--  LINK 5 -->
    <link name="link_5">
        <inertial>
            <origin xyz="-0.01 0 0" rpy="0 0 0"/>
            <mass value="0.15"/>
            <inertia ixx="6e-05" iyy="5e-05" izz="5e-05" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="-0.008 -0.001 0.001" rpy="0 3.14  0"/>
            <geometry>
                <mesh filename="meshes/05_link_5.stl" scale="0.001 0.001 0.001"/>
            </geometry>            
            <material  name="gray">
                <color rgba="0.78 0.75 0.75 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-0.01 0 0" rpy="0 1.57 0"/>
            <geometry>
                <cylinder radius="0.028" length="0.015"/>
            </geometry>
        </collision>
    </link>

    <!--  JOINT 6  -->
    <joint name="joint6" type="fixed">
        <origin xyz="0.0 0 0" rpy="0 -1.57 0"/>
        <parent link="link_5"/>
        <child link="adapter"/>
    </joint>

    <!-- adapter -->
    <link name="adapter">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.3"/>
            <inertia ixx="5e-4" iyy="5e-4" izz="5e-4" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 1.57"/>
            <geometry>
                <mesh filename="meshes/CRS_adapter.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray_blue">
                <color rgba="0.14 0.55 0.68 0.8"/>
            </material>
        </visual>
        <!-- <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
        </collision> -->
    </link>

    <!--  JOINT 7  -->
    <joint name="joint7" type="fixed">
        <origin xyz="0 0 -0.008" rpy="0 0 0"/>
        <parent link="adapter"/>
        <child link="hoop"/>
    </joint>

    <!--  hoop  -->
    <link name="hoop">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="3e-4" iyy="3e-4" izz="3e-4" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 1.57"/>
            <geometry>
                <mesh filename="meshes/hoop.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray_blue">
                <color rgba="0.14 0.55 0.68 0.8"/>
            </material>
        </visual>
        <!-- <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.01"/>
            </geometry>
        </collision> -->
    </link>
</robot>
